{
  "name": "@oceanum/auth-oceanum",
  "version": "0.1.0",
  "description": "Oceanum.io sign-in for oceanumlab: the Oceanum nav in the top bar, and Datamesh credentials in every kernel",
  "license": "BSD-3-Clause",
  "private": true,
  "keywords": [
    "jupyterlab-extension"
  ],
  "files": [
    "kernel/*.py",
    "lib/**/*.{js,d.ts}",
    "schema/*.json",
    "style/**/*"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "scripts": {
    "build": "tsc -b && jupyter-builder build --development True .",
    "build:prod": "tsc -b && jupyter-builder build .",
    "clean": "rimraf lib labextension tsconfig.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "2.24.1",
    "@jupyterlab/application": "^4.6.3",
    "@jupyterlab/apputils": "^4.7.3",
    "@jupyterlab/console": "^4.6.3",
    "@jupyterlab/coreutils": "^6.6.3",
    "@jupyterlab/notebook": "^4.6.3",
    "@jupyterlab/services": "^7.6.3",
    "@jupyterlab/settingregistry": "^4.6.3",
    "@lumino/commands": "^2.3.3",
    "@lumino/coreutils": "^2.2.2",
    "@lumino/disposable": "^2.1.5",
    "@lumino/signaling": "^2.1.5",
    "@lumino/widgets": "^2.8.0",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@oceanum/oceanum-io-nav": "^2.7.0",
    "@oceanum/theme": "^9.6.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "schemaDir": "schema",
    "webpackConfig": "./webpack.config.js",
    "sharedPackages": {
      "react": false,
      "react-dom": false,
      "@mantine/core": false,
      "@mantine/hooks": false,
      "@mantine/notifications": false,
      "@oceanum/oceanum-io-nav": false,
      "@oceanum/theme": false
    }
  }
}
