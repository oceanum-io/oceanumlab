{
  "name": "@oceanum/oceanumlab",
  "version": "4.0.0",
  "description": "A Jupyterlab extension to interact with the Oceanum.io platform",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/oceanum-io/oceanumlab",
  "bugs": {
    "url": "https://github.com/oceanum-io/oceanumlab/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "Oceanum",
    "email": "developers@oceanum.science"
  },
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "schema/*.json"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/oceanum-io/oceanumlab.git"
  },
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "jlpm clean && jlpm build:lib && jlpm build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "npx tsc",
    "clean": "jlpm clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:lintcache": "rimraf .eslintcache .stylelintcache",
    "clean:labextension": "rimraf oceanumlab/labextension",
    "clean:all": "jlpm clean:lib && jlpm clean:labextension && jlpm clean:lintcache",
    "eslint": "jlpm eslint:check --fix",
    "eslint:check": "eslint . --cache --ext .ts,.tsx",
    "install:extension": "jlpm build",
    "lint": "jlpm stylelint && jlpm prettier && jlpm eslint",
    "lint:check": "jlpm stylelint:check && jlpm prettier:check && jlpm eslint:check",
    "prettier": "jlpm prettier:base --write --list-different",
    "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md}\"",
    "prettier:check": "jlpm prettier:base --check",
    "stylelint": "jlpm stylelint:check --fix",
    "stylelint:check": "stylelint --cache \"style/**/*.css\"",
    "test": "jest --coverage --passWithNoTests",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "npx tsc -w",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.1.6",
    "@jupyterlab/apputils": "4.2.6",
    "@jupyterlab/coreutils": "^6.1.6",
    "@jupyterlab/rendermime-interfaces": "3.9.6",
    "@jupyterlab/services": "^7.1.6",
    "@jupyterlab/settingregistry": "^4.1.6",
    "phosphor-react": "^1.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@jupyterlab/builder": "^4.1.6",
    "@jupyterlab/testutils": "^4.1.6",
    "@types/jest": "~29.5.12",
    "@types/json-schema": "^7.0.15",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "~29.7.0",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "stylelint": "^16.3.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended": "^14.0.0",
    "stylelint-config-standard": "~36.0.0",
    "stylelint-prettier": "^5.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "5.4.4"
  },
  "sideEffects": [
    "style/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "discovery": {
      "server": {
        "managers": [
          "pip"
        ],
        "base": {
          "name": "oceanumlab"
        }
      }
    },
    "extension": true,
    "outputDir": "oceanumlab/labextension",
    "schemaDir": "schema",
    "webpackConfig": "./webpack.config.js"
  },
  "jupyter-releaser": {
    "hooks": {
      "before-build-npm": [
        "python -m pip install jupyterlab~=3.1",
        "jlpm"
      ],
      "before-build-python": [
        "jlpm clean:all"
      ]
    }
  }
}
